{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackathon-web",
  "main": "./src/worker.ts",
  // 2026-08-04 or later enables nodejs_compat AsyncLocalStorage, which Solid's request scope needs.
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Without IDs, `wrangler deploy` provisions the D1 database and R2 bucket by name on first deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hackathon-db",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/*/migration.sql",
    },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "hackathon-uploads" }],
  // Hourly run: within each owner's contact window, applies standing permissions and sends their next message.
  // Linked pages are read once a day, at 05:00 UTC.
  "triggers": { "crons": ["0 * * * *"] },
  // Secrets: BETTER_AUTH_SECRET, WORKER_TOKEN, optionally YEXT_API_KEY and the WHATSAPP_* ones. See .dev.vars.example.
  // Locally in .dev.vars, in production via `wrangler secret put`. APP_URL is the public address used in owner links.
}
