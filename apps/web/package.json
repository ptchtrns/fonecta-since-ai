{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface Env ./worker-configuration.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vp build && wrangler deploy"
  },
  "dependencies": {
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.20",
    "better-auth": "1.7.15",
    "drizzle-orm": "1.0.0-rc.5",
    "solid-js": "2.0.0-rc.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.2",
    "daisyui": "5.7.50",
    "drizzle-kit": "1.0.0-rc.5",
    "filesystem-routing": "0.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "wrangler": "4.156.0"
  }
}
